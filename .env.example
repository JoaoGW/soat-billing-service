DATABASE_URL="postgresql://user:password@localhost:5432/billing_hml?sslmode=require"
OTEL_SERVICE_NAME="soat-billing-service"
OTEL_SERVICE_VERSION="local"
OBSERVABILITY_ENABLED="false"
# NEW_RELIC_LICENSE_KEY deve vir de um secret; não salvar valor real aqui.
SERVICE_BUS_NAMESPACE="example.servicebus.windows.net"
SERVICE_BUS_COMMAND_QUEUE="billing.commands"
SERVICE_BUS_EVENT_TOPIC="soat.domain.events"
ENABLE_SERVICE_BUS_WORKER="false"
ENABLE_NOTIFICATION_WORKER="false"
MAIL_HOST="smtp.example.test"
MAIL_PORT="587"
MAIL_USER="placeholder"
MAIL_PASS="placeholder"
MAIL_FROM="oficina@example.test"
JWT_CLIENT_SECRET="replace-with-exclusive-secret-at-least-32-bytes"
JWT_CLIENT_ISSUER="soat-auth-function"
JWT_CLIENT_AUDIENCE="soat-api"
ENABLE_MERCADO_PAGO_COMMANDS="false"
MERCADO_PAGO_ACCESS_TOKEN=""

ENABLE_MERCADO_PAGO_WEBHOOK="false"
ENABLE_MERCADO_PAGO_WEBHOOK_PROCESSOR="false"
MERCADO_PAGO_WEBHOOK_SECRET=""
