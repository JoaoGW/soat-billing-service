# Valores de exemplo. Em Kubernetes todas as variáveis chegam pelo Secret
# soat-billing-runtime (envFrom); nunca versionar valores reais.

# --- HTTP e banco próprio ---
PORT="3000"
NODE_ENV="development"
DATABASE_URL="postgresql://user:password@localhost:5432/billing_hml?sslmode=require"

# --- Autenticação do cliente (JWT emitido pela soat-auth-function) ---
JWT_CLIENT_SECRET="replace-with-exclusive-secret-at-least-32-bytes"
JWT_CLIENT_ISSUER="soat-auth-function"
JWT_CLIENT_AUDIENCE="soat-api"

# --- Observabilidade (OpenTelemetry -> New Relic) ---
OBSERVABILITY_ENABLED="false"
OTEL_SERVICE_NAME="soat-billing-service"
OTEL_SERVICE_VERSION="local"
# Opcional; padrão https://otlp.nr-data.net:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=""
# Obrigatória somente com OBSERVABILITY_ENABLED=true; deve vir de um secret.
NEW_RELIC_LICENSE_KEY=""

# --- Worker Service Bus (comandos do OS e outbox de eventos) ---
ENABLE_SERVICE_BUS_WORKER="false"
SERVICE_BUS_NAMESPACE="example.servicebus.windows.net"
SERVICE_BUS_COMMAND_QUEUE="billing.commands"
SERVICE_BUS_EVENT_TOPIC="soat.domain.events"
# Identidade de workload (injetadas pelo AKS quando a ServiceAccount é federada).
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_FEDERATED_TOKEN_FILE=""
# Chave Ed25519 privada exclusiva do Billing (PEM; \n escapado) para assinar eventos.
BILLING_MESSAGE_PRIVATE_KEY=""
# Chave Ed25519 pública do OS (PEM) para verificar comandos.
OS_MESSAGE_PUBLIC_KEY=""

# --- Evidência de compensação (execution.work-cancelled.v1 e execution.work-failed.v1) ---
# Obrigatória para reembolso e cancelamento de cobrança.
ENABLE_BILLING_COMPENSATION_EVIDENCE="false"
SERVICE_BUS_BILLING_EVIDENCE_SUBSCRIPTION="billing.evidence"
# Chave Ed25519 pública do Execution (PEM) para verificar a evidência.
EXECUTION_MESSAGE_PUBLIC_KEY=""

# --- Mercado Pago (somente credenciais de teste) ---
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""
# Criação de cobrança pelo worker.
ENABLE_MERCADO_PAGO_COMMANDS="false"
# Recebimento e processamento do webhook (ambos precisam estar ativos).
ENABLE_MERCADO_PAGO_WEBHOOK="false"
ENABLE_MERCADO_PAGO_WEBHOOK_PROCESSOR="false"
# Recuperação de cobrança incerta a partir de notificação autenticada.
ENABLE_MERCADO_PAGO_CHARGE_RECONCILIATION="false"
# Reembolso e sua reconciliação (a reconciliação exige o reembolso habilitado).
ENABLE_MERCADO_PAGO_REFUND_COMMANDS="false"
ENABLE_MERCADO_PAGO_REFUND_RECONCILIATION="false"
# Cancelamento de cobrança sem pagamento e intervalo de varredura (1000 a 3600000 ms).
ENABLE_MERCADO_PAGO_CANCEL_COMMANDS="false"
BILLING_CANCEL_POLL_INTERVAL_MS="60000"

# --- Notificações por e-mail ---
ENABLE_NOTIFICATION_WORKER="false"
MAIL_HOST="smtp.example.test"
MAIL_PORT="587"
MAIL_USER="placeholder"
MAIL_PASS="placeholder"
MAIL_FROM="oficina@example.test"

# --- Somente ambiente local com emuladores ---
# Sem ALLOW_LOCAL_EMULATORS=true as duas variáveis seguintes são ignoradas.
ALLOW_LOCAL_EMULATORS="false"
# Aceita apenas connection string com UseDevelopmentEmulator=true.
SERVICE_BUS_CONNECTION_STRING=""
# Provedor simulado; sem a trava usa https://api.mercadopago.com.
MERCADO_PAGO_API_BASE_URL=""
